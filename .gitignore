# Al repositorio va lo que el juego necesita para cargar el addon, más los README.
# CHANGELOG, docs/, CLAUDE.md y .agents/ se quedan solo en local.
/*
!/.gitignore
!/wcdpanel.toc
!/embeds.xml
!/Libs/
!/Locales/
!/Core/
!/Plugins/
!/README.md
!/README.es.md

# Restos de editores y del sistema dentro de las carpetas del addon
*.bak
*.swp
.DS_Store
Thumbs.db
